---
// DESIGN-SYSTEM 3.32. Phones only: pantry.ts shows it while the in-flow pantry module is out of view and the
// kitchen is not empty. Edit opens the pantry sheet.
---
<div class="kitchen-bar" id="kitchen-bar" hidden>
  <p class="kitchen-bar__label" id="kitchen-bar-label">My kitchen</p>
  <button class="btn btn--secondary btn--sm" type="button" aria-haspopup="dialog" data-open-pantry>Edit</button>
</div>
