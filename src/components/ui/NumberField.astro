---
// DESIGN-SYSTEM 3.5. Steppers change the value by `step` and clamp; at a bound a stepper gets
// aria-disabled (not disabled, so focus is not lost mid-press). Blur validation and its message belong to the
// tool: it fills #{id}-error, unhides it and sets aria-invalid. Steppers fire input and change events.
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  min: number;
  max: number;
  step?: number;
  value: number;
  unit: string;
  hint: string;
  decLabel: string;
  incLabel: string;
  class?: string;
}
const { id, label, min, max, step = 1, value, unit, hint, decLabel, incLabel, class: cls } = Astro.props;
---
<div class:list={['field', cls]}>
  <label class="field__label" for={id}>{label}</label>
  <div class="numfield">
    <button class="icon-btn icon-btn--md" type="button" data-step="-1" aria-label={decLabel} aria-controls={id} aria-disabled={value <= min ? 'true' : 'false'}><Icon name="minus" /></button>
    <input class="input numfield__input num" id={id} type="number" inputmode="numeric" min={min} max={max} step={step} value={value} aria-describedby={`${id}-error ${id}-hint`} />
    <span class="numfield__unit">{unit}</span>
    <button class="icon-btn icon-btn--md" type="button" data-step="1" aria-label={incLabel} aria-controls={id} aria-disabled={value >= max ? 'true' : 'false'}><Icon name="plus" /></button>
  </div>
  <p class="field__hint" id={`${id}-hint`}>{hint}</p>
  <p class="field__error" id={`${id}-error`} hidden><Icon name="circle-alert" size={16} /><span></span></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.numfield').forEach((box) => {
    const input = box.querySelector<HTMLInputElement>('input')!;
    const steppers = [...box.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const sync = () => {
      const v = Number(input.value), min = Number(input.min), max = Number(input.max);
      steppers.forEach((b) => b.setAttribute('aria-disabled', String(Number(b.dataset.step) < 0 ? v <= min : v >= max)));
    };
    steppers.forEach((b) => b.addEventListener('click', () => {
      if (b.getAttribute('aria-disabled') === 'true') return;
      const min = Number(input.min), max = Number(input.max), step = Number(input.step) || 1;
      const base = Number.isFinite(input.valueAsNumber) ? input.valueAsNumber : min;
      input.value = String(Math.min(max, Math.max(min, base + step * Number(b.dataset.step))));
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }));
    input.addEventListener('input', sync);
    input.addEventListener('change', sync);
  });
</script>
