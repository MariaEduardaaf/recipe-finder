---
// Every page: head (SEO, fonts, theme, JSON-LD), skip link, Header, <main id="main">, Footer (DESIGN-SYSTEM 5).
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { SITE, THEME_COLOR } from '../site';

export interface BaseProps {
  /** Title Case, the only Title Case in the product (DESIGN-SYSTEM 2.3). */
  title: string;
  description: string;
  /** Route path, e.g. "/sleep/": canonical URL and the header's current item. */
  path: string;
  /** 404 and /kit/: noindex and no canonical. */
  noindex?: boolean;
  jsonLd?: object[];
  ogImage?: string;
  /** Footer PrototypeNotice text (recipe pages), shown while SITE.prototypeNotices is true. */
  prototypeNotice?: string;
  class?: string;
}
type Props = BaseProps;
const { title, description, path, noindex = false, jsonLd = [], ogImage, prototypeNotice, class: cls } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const image = new URL(ogImage ?? '/og-default.png', SITE.url).href;
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    {!ogImage && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-sans" preload />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
    <slot name="head" />
  </head>
  <body class={cls}>
    <Header path={path} />
    <main class="site-main" id="main" tabindex="-1"><slot /></main>
    <Footer prototypeNotice={prototypeNotice} />
  </body>
</html>
