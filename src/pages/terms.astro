---
// site-pages 8.4. A draft; legal review is a launch step (BUILD-PLAN 6).
import ContentPage from '../layouts/ContentPage.astro';
import PrototypeNotice from '../components/ui/PrototypeNotice.astro';
import ExtLink from '../components/ui/ExtLink.astro';
import { SITE } from '../site';

const toc = [
  { id: 'using', label: `Using ${SITE.name}` },
  { id: 'advice', label: 'Information, not advice' },
  { id: 'data', label: 'Data from others' },
  { id: 'links', label: 'Links to other sites' },
  { id: 'licenses', label: 'Data licenses' },
  { id: 'warranty', label: 'No warranty' },
  { id: 'changes', label: 'Changes' },
  { id: 'contact', label: 'Contact' },
];
const H = Object.fromEntries(toc.map((t) => [t.id, t.label])); // headings and "On this page" share one list
---
<ContentPage
  title={`Terms of Use | ${SITE.name}`}
  description={`The rules for using ${SITE.name}: free for personal use, information, not advice, and recipe data from TheMealDB.`}
  path="/terms/"
  h1="Terms of use"
  lede="In short: the tools are free, the answers are a starting point, and other sites have their own rules."
  updated="2026-10-12"
  toc={toc}
>
  <PrototypeNotice text="these terms are a draft, pending the owner’s legal review." />

  <section class="section prose" aria-labelledby="using">
    <h2 id="using">{H.using}</h2>
    <p>You can use the tools for free, for personal use, without an account. Please don’t copy the site or its data in bulk with automated tools, or try to break or overload it.</p>
  </section>

  <section class="section prose" aria-labelledby="advice">
    <h2 id="advice">{H.advice}</h2>
    <p>Matches are based on ingredient names. Always check the full recipe on the publisher’s site for allergens, quantities and food safety.</p>
  </section>

  <section class="section prose" aria-labelledby="data">
    <h2 id="data">{H.data}</h2>
    <p>Recipe data and photos come from TheMealDB and the sites that published each recipe. Check allergens and instructions on the source site. We can’t guarantee that any recipe is accurate.</p>
  </section>

  <section class="section prose" aria-labelledby="links">
    <h2 id="links">{H.links}</h2>
    <p>Recipes lead to the sites that published them. We don’t control them and aren’t responsible for their content or policies.</p>
  </section>

  <section class="section prose" aria-labelledby="licenses">
    <h2 id="licenses">{H.licenses}</h2>
    <p>Recipe data from <ExtLink href="https://www.themealdb.com/">TheMealDB</ExtLink>, used under its terms.</p>
  </section>

  <section class="section prose" aria-labelledby="warranty">
    <h2 id="warranty">{H.warranty}</h2>
    <p>{SITE.name} is provided as is, without warranties of any kind. As far as the law allows, we aren’t liable for losses that come from using the tools.</p>
  </section>

  <section class="section prose" aria-labelledby="changes">
    <h2 id="changes">{H.changes}</h2>
    <p>We may update these terms; the date at the top shows the current version.</p>
  </section>

  <section class="section prose" aria-labelledby="contact">
    <h2 id="contact">{H.contact}</h2>
    {SITE.contactEmail
      ? <p>Questions about these terms? Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
      : <PrototypeNotice text="the contact email goes here before launch." />}
  </section>
</ContentPage>
